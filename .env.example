# Copy to .env.local. Never commit real keys.
# HallPass runs the deterministic rules engine until these are set.

# Firebase web app config (Project settings → Your apps → SDK setup).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# reCAPTCHA Enterprise site key used by Firebase App Check.
# Create a score-based key (checkbox challenge off). Register it on the
# Firebase App Check app. Do not add localhost to a production key.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Print an App Check debug token in the browser console for localhost.
# Register that token under App Check → Manage debug tokens.
# Leave this unset in any build you ship.
NEXT_PUBLIC_APPCHECK_DEBUG=

# rules | hybrid
# CI sets rules so the scorecard never calls a model.
# Leave unset locally: HallPass uses hybrid when the Firebase values above exist,
# and rules otherwise.
NEXT_PUBLIC_HALLPASS_INFERENCE=
